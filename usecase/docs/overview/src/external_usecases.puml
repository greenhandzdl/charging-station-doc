'@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 14
title 系统与外部交互用例
skinparam useCaseShape rectangle

actor "支付网关" as P
actor "系统" as S

usecase "支付回调" as CB
usecase "自动扣费结算" as AUTO
usecase "统计报表生成" as GS
usecase "审计日志记录" as AUDIT

P --> CB
S --> AUTO
S --> GS
S --> AUDIT

AUTO <.left. CB : <<include>>
GS ..> AUDIT : <<extend>>
@enduml