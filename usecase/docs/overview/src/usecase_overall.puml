@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 14
title 总体用例总览
skinparam useCaseShape rectangle

actor "未授权用户" as G
actor "用户" as U
actor "维修人员" as M
actor "管理员" as A
actor "最高管理者" as SA
actor "Mock充电机" as MC
actor "支付网关" as P
actor "系统" as S

usecase "注册/登录" as UC
usecase "账户充值" as RA
usecase "启动充电" as SC
usecase "余额校验" as BAL
usecase "结束充电" as EC
usecase "自动扣费" as AD
usecase "强制结束充电" as FSC
usecase "查看充电记录" as VCR
usecase "查看支付记录" as VPR
usecase "提交故障报修" as SRT
usecase "管理充电站/充电桩" as MM
usecase "用户权限管理" as PM
usecase "处理报修" as HR
usecase "生成统计报表" as GS
usecase "充电记录快捷视图" as QV
usecase "充电桩状态快捷查询" as QC
usecase "查看报修记录" as VR
usecase "查询充电状态" as QC_CM

G --> UC

U --> RA
U --> SC
U --> EC
U --> AD
U --> VCR
U --> VPR
U --> SRT
U --> QV
U --> QC
U --> VR

M --> RA
M --> SC
M --> EC
M --> AD
M --> VCR
M --> VPR
M --> SRT
M --> HR
M --> QV
M --> QC
M --> VR

A --> MM
A --> PM
A --> VCR
A --> VPR
A --> HR
A --> VR
A --> GS
A --> FSC
A --> EC
A --> QV
A --> QC
SA --> MM
SA --> PM
SA --> GS
SA --> FSC
SA --> VPR
SA --> VCR
SA --> QV

MC --> SC
MC --> EC
MC --> QC_CM
note top of MC : Swing 桌面客户端\n模拟物理充电机交互

P --> RA
S --> GS

SC <.left. BAL : <<include>>
EC <.right. AD : <<include>>
@enduml