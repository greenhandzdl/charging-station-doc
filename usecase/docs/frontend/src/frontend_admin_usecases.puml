@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 14
title 前端用例 — 管理操作
skinparam useCaseShape rectangle

actor "管理员" as A
actor "维修人员" as M
actor "最高管理者" as SA

note top of A : Flutter 客户端实现
note top of M : Flutter 客户端实现
note top of SA : Flutter 客户端实现

usecase "处理报修" as HR
usecase "管理充电站/充电桩" as MM
usecase "用户权限管理" as PM
usecase "管理用户" as MU
usecase "强制结束充电" as FSC
usecase "结束充电" as EC
usecase "生成统计报表" as GS
usecase "充电桩状态快捷查询" as QC
usecase "查看报修记录" as VR
usecase "查看支付记录" as VPR
usecase "查看充电记录" as VCR
usecase "充电记录快捷视图" as QV
usecase "查看用户充电统计" as UCS
usecase "故障充电桩列表" as FCL
usecase "直接关闭报修" as DCR
usecase "退回报修" as RR

A --> HR
A --> DCR
A --> VR
A --> MM
A --> PM
A --> MU
A --> FSC
A --> EC
A --> QC
A --> QV
A --> VCR
A --> VPR
A --> UCS
A --> RR
A --> FCL
SA --> FCL
SA --> RR
SA --> VR
M --> HR
M --> VR
M --> VPR
M --> VCR
M --> QV
M --> QC
SA --> MM
SA --> PM
SA --> MU
SA --> FSC
SA --> GS
SA --> VCR
SA --> QC
SA --> QV
SA --> VPR
SA --> UCS
SA --> DCR
@enduml