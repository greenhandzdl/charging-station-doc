'@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 14
title 前端用例 — 管理操作
skinparam useCaseShape rectangle

actor "管理员" as A
actor "维修人员" as M
actor "最高管理者" as SA

note top of A : Flutter 客户端实现
note top of M : Flutter 客户端实现
note top of SA : Flutter 客户端实现

usecase "处理报修" as HR
usecase "管理充电站/充电桩" as MM
usecase "用户权限管理" as PM
usecase "管理用户" as MU
usecase "强制结束充电" as FSC
usecase "生成统计报表" as GS
usecase "充电桩状态快捷查询" as QC
usecase "充电记录快捷视图" as QV

A --> HR
A --> MM
A --> PM
A --> MU
A --> FSC
A --> GS
A --> QC
A --> QV
M --> HR
M --> QV
M --> QC
SA --> MM
SA --> PM
SA --> MU
SA --> FSC
SA --> GS
SA --> QC
SA --> QV
@enduml