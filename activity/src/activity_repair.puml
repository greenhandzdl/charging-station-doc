'@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 14
title 故障报修处理活动图
start

partition "用户" {
  :发现故障;
  :提交报修单 [状态: open];
}

partition "管理员" {
  :查看未处理报修;
  :分配维修人员 [状态: in_progress];
}

partition "系统" {
  :将充电桩状态设为"故障";
  fork
    :通知维修人员;
  fork again
  endfork
}

partition "维修人员" {
  repeat
    :接收任务;
    while (维修中?)
      :维修操作;
    endwhile
    :维修完成;
  repeat while (审核通过?) is (否)
  ->是;
}

partition "管理员" {
  :审核维修结果;
}

partition "系统" {
  :更新报修单状态为"已处理" [状态: closed];
  :将充电桩状态恢复为"空闲";
}

stop
@enduml