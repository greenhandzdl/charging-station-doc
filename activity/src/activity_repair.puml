@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 14
title 故障报修处理活动图
start

partition "用户" {
  :发现故障;
  :提交报修单 [状态: open];
}

partition "管理员" {
  :查看未处理报修;
  :分配维修人员 [状态: in_progress];
}

partition "系统" {
  :将充电桩状态设为"故障";
  fork
    :通知维修人员;
  fork again
  endfork
}

partition "维修人员" {
  while (维修中?)
    :接收任务;
    :维修操作;
    :维修完成 [状态: resolved];
  endwhile
}

partition "管理员" {
  :审核维修结果;
}

partition "系统" {
  if (审核通过?) then (是)
    :更新报修单状态为"已关闭" [状态: closed];
    :将充电桩状态恢复为"空闲";
    stop
  else (否)
    :退回返工;
    note right: 退回原因写入 reject_reason\n状态回退到 in_progress
    partition "系统" {
      :更新报修单状态回退到 in_progress;
      :记录审计日志;
    }
    :通知维修人员重新维修;
    --> "接收任务" as return_to_repair
  endif
}

@enduml