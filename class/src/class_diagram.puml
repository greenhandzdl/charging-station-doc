@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 14
title 充电站管理系统类图总览
skinparam package {
  BackgroundColor #F0F0F0
  BorderColor #666666
}

package "Mock充电机客户端 (Swing)" as MC #FFB6C1 {
  class MockChargerClient
  class ChargerUIPanel
  class ChargeSimulator
}

MC -right-> HTTP : HTTP 请求

package "Flutter 前端 (Dart Model)" as FE #ADD8E6 {
  class "UserModel" as FUser
  class "StationModel" as FStation
  class "ChargerModel" as FCharger
  class "ChargeRecordModel" as FCRecord {
    - id: String
    - startTime: String
    - endTime: String
    - energyKwh: double
    - fee: double
    - status: String
    - deductionStatus: String
    - userName: String
    - plateNumber: String
    - chargerCode: String
    - stationName: String
  }
  class "PaymentModel" as FPayment
  class "RepairModel" as FRepair
  class "ApiService" as Api
  class "AuthProvider" as Auth
  class "ChargingProvider" as CP
  class "RepairProvider" as RP
  class "StatisticsProvider" as StatsP
}

class "HTTP REST API\nJSON / JWT Token" as HTTP #LightGray

package "后端层 (Spring Boot Java)" as BE #F0E68C {

  package "控制器 (Controller)" as CTRL {
    class ChargingController
    class PaymentController
    class UserController
    class RepairController
    class StationController
    class StatisticsController
  }

  package "服务 (Service)" as SVC {
    interface ChargingService
    class ChargingServiceImpl implements ChargingService
    note right of ChargingServiceImpl : + forceStop()
    interface PaymentService
    class PaymentServiceImpl implements PaymentService
    interface RepairService
    class RepairServiceImpl implements RepairService
    interface ChargerService
    class ChargerServiceImpl implements ChargerService
    interface UserService
    class UserServiceImpl implements UserService
    interface StatisticsService
    class StatisticsServiceImpl implements StatisticsService
  }

  package "计费 (Billing)" as BILL {
    interface BillingService
    class BillingServiceImpl implements BillingService
  }

  package "策略/工厂" as DP {
    interface PricingStrategy
    class PaymentFactory
    interface PaymentChannel
  }

  package "数据访问 (Mapper/MyBatis)" as MAP {
    interface UserMapper
    interface ChargerMapper
    interface ChargeRecordMapper
    interface PaymentMapper
    interface RepairMapper
    interface AuditLogMapper
  }

  package "基础设施" as INF {
    class "HikariCP 连接池" as Hikari
    class "MyBatis SqlSessionFactory" as SqlSession
    class "事务管理器" as TX
    class "RedisTemplate" as Redis
    class "PageHelper" as Page
  }
}

' ===== 架构边界 =====
FE -right-> HTTP : HTTP 请求
HTTP -right-> BE : 反向代理/Nginx

' ===== 前端内部 =====
Api ..> FUser : 返回
Api ..> FStation : 返回
Api ..> FCharger : 返回
Api ..> FCRecord : 返回
Api ..> FPayment : 返回
Api ..> FRepair : 返回
Auth ..> Api : 调用
CP ..> Api : 调用
RP ..> Api : 调用

' ===== 后端分层调用 =====
CTRL --> SVC : 调用服务
SVC --> MAP : 数据访问
SVC --> BILL : 计费计算
SVC --> ChargerService : 充电桩管理
BILL --> DP : 委托计费策略
MAP --> INF : 基础设施支撑

note top of HTTP
  前端通过 HTTP REST API 与后端通信
  接口前缀: /api/v1/
  认证方式: Authorization: Bearer {access_token}
  Token 过期自动刷新 (refresh_token)
  请求/响应格式: JSON (Content-Type: application/json)

  Mock充电机客户端同样通过 HTTP REST API 调用后端
  调用端点: /api/v1/charges/start
           /api/v1/charges/stop
           /api/v1/charges
  认证方式: 专用 mock 作用域 JWT Token
  Token scope: mock_charger_only (禁止访问管理/统计端点)
  使用隔离测试用户数据，不影响真实用户
  所有访问必须经过 Controller 层，禁止直接调用 Mapper
end note

@enduml