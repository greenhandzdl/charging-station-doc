@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 14
title 充电站管理系统后端类图 (Spring Boot Java)
skinparam package {
  BackgroundColor #F0F0F0
  BorderColor #666666
}

package "实体 (Entity)" as ENT #F0E68C {
  class Station {
    - id: UUID
    - name: String
    - location: String
    - chargerCount: int
    - status: StationStatus
  }

  class Charger {
    - id: UUID
    - stationId: UUID
    - chargerCode: String
    - type: ChargerType
    - status: ChargerStatus
  }

  class User {
    - id: UUID
    - name: String
    - phone: String
    - plateNumber: String
    - passwordHash: String
    - role: UserRole
    - balance: BigDecimal
    - frozenUntil: LocalDateTime
  }
  note right of User : passwordHash 在 API 响应中被过滤，不传输至客户端
  note right of User : 并发控制通过 WHERE balance >= ? 原子扣减实现，不使用 version 乐观锁
  note right of User : frozenUntil 非空时表示账户被冻结至该时间

  class ChargeRecord {
    - id: UUID
    - userId: UUID
    - chargerId: UUID
    - startTime: LocalDateTime
    - endTime: LocalDateTime
    - energyKwh: BigDecimal
    - fee: BigDecimal
    - status: RecordStatus
    - deductionStatus: DeductionStatus
  }

  class Payment {
    - id: UUID
    - userId: UUID
    - chargeRecordId: UUID
    - method: String
    - amount: BigDecimal
    - status: PaymentStatus
    - gatewayTxId: String
    - gatewayCallbackPayload: JSON
    - createdAt: LocalDateTime
  }

  class Repair {
    - id: UUID
    - chargerId: UUID
    - reporterId: UUID
    - description: String
    - status: RepairStatus
    - handledBy: UUID
    - reportedAt: LocalDateTime
    - handledAt: LocalDateTime
  }

  class AuditLog {
    - id: UUID
    - actorId: UUID
    - actorType: String
    - action: String
    - resource: String
    - resourceId: UUID
    - payload: JSON
    - clientIp: String
    - userAgent: String
    - createdAt: LocalDateTime
  }
}

package "枚举 (Enum)" as ENUM #F0E68C {
  enum StationStatus {
    NORMAL
    MAINTENANCE
  }

  enum ChargerType {
    FAST
    SLOW
  }

  enum ChargerStatus {
    IDLE
    CHARGING
    FAULT
  }

  enum UserRole {
    USER
    MAINTAINER
    ADMIN
    SUPER_ADMIN
  }

  enum RecordStatus {
    PROCESSING
    COMPLETED
  }

  enum DeductionStatus {
    PENDING
    PAID
    ARREARS
  }

  enum PaymentStatus {
    PENDING
    SUCCESS
    FAILED
  }

  enum RepairStatus {
    OPEN
    IN_PROGRESS
    RESOLVED
    CLOSED
  }
}

package "服务 (Service)" as SVC #F0E68C {
  interface ChargingService {
    + startCharge()
    + stopCharge()
    + calculateFee()
    + forceStop()
  }

  class ChargingServiceImpl implements ChargingService {
    + startCharge()
    + stopCharge()
    + calculateFee()
    + forceStop()
  }

  interface PaymentService {
    + recharge()
    + processCallback()
    + autoDeduct()
  }

  class PaymentServiceImpl implements PaymentService {
    + recharge()
    + processCallback()
    + autoDeduct()
  }

  interface RepairService {
    + submit()
    + assign()
    + resolve()
  }

  class RepairServiceImpl implements RepairService {
    + submit()
    + assign()
    + resolve()
  }

  interface UserService {
    + login()
    + register()
    + recharge()
  }

  class UserServiceImpl implements UserService {
    + login()
    + register()
    + recharge()
  }

  interface StatisticsService {
    + generateReport(): ReportVO
    + getUserChargingStats(): List
    + getStationAnalysis(): List
    + getChargerUtilization(): Map
  }

  class StatisticsServiceImpl implements StatisticsService {
    + generateReport(): ReportVO
    + getUserChargingStats(): List
    + getStationAnalysis(): List
    + getChargerUtilization(): Map
  }

  interface BillingService {
    + calculateFee(chargerType, energyKwh): BigDecimal
  }

  class BillingServiceImpl implements BillingService {
    + calculateFee(chargerType, energyKwh): BigDecimal
  }
}

package "策略 (Strategy)" as STR #F0E68C {
  interface PricingStrategy {
    + calculate(energyKwh: BigDecimal): BigDecimal
  }

  class StandardPricing implements PricingStrategy {
    + calculate(energyKwh: BigDecimal): BigDecimal
  }
}

package "工厂 (Factory)" as FAC #F0E68C {
  interface PaymentChannel {
    + processPayment(amount: BigDecimal): boolean
  }

  class PaymentFactory {
    + createPayment(method: String): PaymentChannel
  }

  class WechatPayChannel implements PaymentChannel {
    + processPayment(amount: BigDecimal): boolean
  }

  class AlipayChannel implements PaymentChannel {
    + processPayment(amount: BigDecimal): boolean
  }
}

' ===== 实体关系 =====
Station "1" --> "0..*" Charger : 包含
Station --> StationStatus
Charger --> ChargerType
Charger --> ChargerStatus
User --> UserRole
ChargeRecord --> RecordStatus
ChargeRecord --> DeductionStatus
Payment --> PaymentStatus
Repair --> RepairStatus

' ===== Service 依赖实体 =====
ChargingService ..> ChargeRecord
ChargingService ..> Charger
ChargingService ..> User
PaymentService ..> Payment
PaymentService ..> ChargeRecord
UserService ..> User
RepairService ..> Repair
RepairService ..> Charger
StatisticsServiceImpl ..> ChargeRecord
StatisticsServiceImpl ..> Payment
StatisticsServiceImpl ..> Station
StatisticsServiceImpl ..> Charger

' ===== 设计模式 =====
ChargingService --> PricingStrategy
BillingService --> PricingStrategy : 委托计费策略
PaymentFactory ..> PaymentChannel : 创建

' ===== 实体间关联 =====
User "1" --> "0..*" ChargeRecord : 发起
Charger "1" --> "0..*" ChargeRecord : 被使用
User "1" --> "0..*" Payment : 支付
User "1" --> "0..*" Repair : 报修/处理
ChargeRecord "1" --> "0..1" Payment : 产生
User "1" --> "0..*" AuditLog : 操作记录

@enduml