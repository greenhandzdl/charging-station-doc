@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 14
title 充电站管理系统后端类图 (Spring Boot Java)
skinparam package {
  BackgroundColor #F0F0F0
  BorderColor #666666
}

package "Mock充电机客户端 (Swing)" as MOCK #FFB6C1 {
  class MockChargerClient {
    - frame: JFrame
    - chargerCode: String
    - stationId: String
    - currentRecordId: String
    - chargingTimer: Timer
    - simulatedEnergy: double
    - authToken: String
    - tokenScope: String
    - testUserId: String
    - isTestMode: boolean
  }
  note right of MockChargerClient : Swing 桌面客户端\n模拟物理充电机交互\n包含插枪/拔枪按钮、充电进度条\n电量模拟增长(0.1kWh/秒)\n调用后端充电 API\n\n双权限模式：\n- 普通模式: mock_user + JWT 认证\n  仅可见自己的测试充电桩\n- 高级模式: ADVANCED_API_KEY 密钥\n  可见所有充电桩+中间件交互\n  仅测试环境开放

  class ChargerUIPanel {
    - plugButton: JButton
    - unplugButton: JButton
    - progressBar: JProgressBar
    - statusLabel: JLabel
    - energyLabel: JLabel
    - qrCodeDisplay: JLabel
  }
  note right of ChargerUIPanel : Swing 组件面板\n模拟充电机显示屏\n显示当前状态/电量/费用

  class ChargeSimulator {
    - startTime: LocalDateTime
    - isCharging: boolean
    - minEnergyKwh: double
    - maxEnergyKwh: double
    + startSimulation(): void
    + stopSimulation(): SimulationResult
    + getCurrentEnergy(): double
  }
  note right of ChargeSimulator : 模拟电量生成\n每 tick 增加 0.1kWh\n记录充电时长\n电量范围 1.0-50.0 kWh\n模拟合理范围，防止溢出异常

  MockChargerClient --> ChargerUIPanel : 包含
  MockChargerClient --> ChargeSimulator : 模拟引擎
  MockChargerClient ..> Nginx : HTTPS 请求（依赖）
  Nginx --> ChargingController : 路由 /api/v1/charges/*
  note on link #red : Nginx 层: location /api/v1/charges/ (前缀匹配)\n转发至后端，其他路径拒绝\nJWT scope = mock_charger_only 做二次校验\n双层安全隔离：网络层 + 认证层
  ChargerUIPanel ..> MockChargerClient : 事件回调
}

package "实体 (Entity)" as ENT #F0E68C {
  class Station {
    - id: UUID
    - name: String
    - location: String
    - chargerCount: int
    - status: StationStatus
    - createdAt: LocalDateTime
    - updatedAt: LocalDateTime
  }

  class Charger {
    - id: UUID
    - stationId: UUID
    - chargerCode: String
    - type: ChargerType
    - status: ChargerStatus
    - createdAt: LocalDateTime
    - updatedAt: LocalDateTime
  }

  class User {
    - id: UUID
    - name: String
    - phone: String
    - plateNumber: String
    - passwordHash: String
    - role: UserRole
    - balance: BigDecimal
    - frozenUntil: LocalDateTime
    - failedLoginAttempts: int
    - accountLockedUntil: LocalDateTime
    - passwordResetToken: String
    - passwordResetTokenHash: String
    - resetTokenExpiresAt: LocalDateTime
    - createdAt: LocalDateTime
    - updatedAt: LocalDateTime
  }
  note right of User : passwordResetToken 存储的是 bcrypt 哈希值\n不存储明文令牌，防止数据库泄露时被直接用于重置密码\npasswordResetTokenHash 为 SHA-256 哈希，用作 O(1) 查找索引
  note right of User : passwordHash 通过 @JsonIgnore 在序列化时过滤\n或在 Service 层返回 UserDTO（不含 passwordHash 字段）\n确保密码哈希值永不传输至客户端
  note right of User : 并发控制通过 WHERE balance >= ? 原子扣减实现，不使用 version 乐观锁
  note right of User : frozenUntil 非空时表示账户被冻结至该时间
  note right of User : failedLoginAttempts >= 5 触发验证码，>= 10 锁定账户

  class ChargeRecord {
    - id: UUID
    - userId: UUID
    - chargerId: UUID
    - startTime: LocalDateTime
    - endTime: LocalDateTime
    - energyKwh: BigDecimal
    - fee: BigDecimal
    - status: RecordStatus
    - deductionStatus: DeductionStatus
    - createdAt: LocalDateTime
  }

  class Payment {
    - id: UUID
    - userId: UUID
    - chargeRecordId: UUID
    - method: String  ' wechat / alipay / card / system / auto_deduct
    - amount: BigDecimal
    - status: PaymentStatus
    - gatewayTxId: String
    - gatewayCallbackPayload: String
    - createdAt: LocalDateTime
  }

  class Repair {
    - id: UUID
    - chargerId: UUID
    - reporterId: UUID
    - description: String
    - status: RepairStatus
    - handledBy: UUID
    - reportedAt: LocalDateTime
    - handledAt: LocalDateTime
    - rejectReason: String
  }

  class AuditLog {
    - id: UUID
    - actorId: UUID
    - actorType: String
    - action: String
    - resource: String
    - resourceId: UUID
    - payload: JSON
    - clientIp: String
    - userAgent: String
    - createdAt: LocalDateTime
  }
}

package "枚举 (Enum)" as ENUM #F0E68C {
  enum StationStatus {
    NORMAL
    MAINTENANCE
  }

  enum ChargerType {
    FAST
    SLOW
  }

  enum ChargerStatus {
    IDLE
    CHARGING
    FAULT
  }

  enum UserRole {
    USER
    MAINTAINER
    ADMIN
    SUPER_ADMIN
  }

  enum RecordStatus {
    PROCESSING
    COMPLETED
  }

  enum DeductionStatus {
    PENDING
    PAID
    ARREARS
  }

  enum PaymentStatus {
    PENDING
    APPROVED
    SUCCESS
    FAILED
  }

  enum RepairStatus {
    OPEN
    IN_PROGRESS
    RESOLVED
    CLOSED
  }
}

package "控制器 (Controller)" as CTRL #B0C4DE {
  class ChargingController {
    @PostMapping("/charges/start")
    @PreAuthorize("isAuthenticated()")
    + startCharge(@Valid @RequestBody req): ResponseEntity
    @PostMapping("/charges/stop")
    @PreAuthorize("@chargeGuard.canStop(authentication, #req.recordId)")
    + stopCharge(@Valid @RequestBody req): ResponseEntity
    note right of ChargingController : stopCharge 使用 ChargeGuard bean 进行授权\n@chargeGuard.canStop() 在注解层校验:\n- 普通用户仅能结束自己的充电记录\n- 管理员可结束任意充电记录\n- recordId 来自请求体，由 ChargeGuard 查询归属\n相比旧 isAuthenticated() + Service 层校验模式\n此模式在 Filter 链早期拒绝未授权请求\n减少数据库无意义访问\n\nstartCharge: Service 层检查用户无 processing 状态的记录\n防止同一用户同时启动多笔充电
    @PostMapping("/charges/{id}/force-stop")
    @PreAuthorize("hasRole('ADMIN') or hasRole('SUPER_ADMIN')")
    + forceStop(@PathVariable id, @RequestBody req): ResponseEntity
    @GetMapping("/charges")
    @PreAuthorize("isAuthenticated()")
    + queryCharges(@RequestParam params): ResponseEntity
  }

  class PaymentController {
    @PostMapping("/payments/recharge")
    @PreAuthorize("isAuthenticated()")
    + recharge(@RequestBody req): ResponseEntity
    @PostMapping("/payments/callback")
    @PreAuthorize("hasIpAddress('10.0.0.0/8')")  ' 此 IP 段为开发环境示例，生产环境需精确配置网关 IP 或启用 mTLS
    + handleCallback(@RequestBody callback): ResponseEntity
    note right of PaymentController : handleCallback 由支付网关回调\n此 IP 段为开发环境示例，生产环境需精确配置网关 IP 或启用 mTLS\nNginx 层: IP 白名单 + mTLS\nController 层: @PreAuthorize hasIpAddress 防御深度\nService 层: HMAC-SHA256 签名校验
    @GetMapping("/payments")
    @PreAuthorize("isAuthenticated()")
    + queryPayments(@RequestParam params): ResponseEntity
    note right of PaymentController : queryPayments 在 Service 层\n按当前用户 ID 过滤，非管理员\n仅能查看自己的支付记录
    @GetMapping("/payments/pending")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + listPendingPayments(): ResponseEntity
    @PutMapping("/payments/{id}/approve")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + approvePayment(@PathVariable id): ResponseEntity
    @PutMapping("/payments/{id}/reject")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + rejectPayment(@PathVariable id): ResponseEntity
    @PostMapping("/payments/pay-arrears")
    @PreAuthorize("isAuthenticated()")
    + payArrears(@RequestBody req): ResponseEntity
  }

  class UserController {
    @PostMapping("/auth/register")
    @PreAuthorize("permitAll()")
    + register(@Valid @RequestBody req): ResponseEntity
    @PostMapping("/auth/login")
    @PreAuthorize("permitAll()")
    + login(@Valid @RequestBody req): ResponseEntity
    note right of UserController : login 加 @Valid 校验请求体字段格式:\nphone 必填且格式合法\npassword 必填且长度 >= 6\n防止空值/无效参数直达 Service 层\n减少无效数据库查询
    @PostMapping("/auth/refresh")
    @PreAuthorize("isAuthenticated()")
    + refreshToken(@RequestBody req): ResponseEntity
    @PostMapping("/auth/password-reset")
    @PreAuthorize("permitAll()")
    + resetPassword(@RequestBody req): ResponseEntity
    @PostMapping("/auth/password-reset/confirm")
    @PreAuthorize("permitAll()")
    + confirmPasswordReset(@RequestBody req): ResponseEntity
    @PutMapping("/auth/password")
    @PreAuthorize("isAuthenticated()")
    + changePassword(@RequestBody req): ResponseEntity
    @GetMapping("/users")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + listUsers(@RequestParam params): ResponseEntity
    @PutMapping("/users/{id}")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + updateUser(@PathVariable id, @RequestBody req): ResponseEntity
    note right of UserController : updateUser 安全约束:\nADMIN 不可修改其他 ADMIN 或 SUPER_ADMIN\nSUPER_ADMIN 不可修改自身\nService 层校验后返回 403
    @DeleteMapping("/users/{id}")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + deleteUser(@PathVariable id): ResponseEntity
    note right of UserController : deleteUser 安全约束:\nADMIN 不可删除其他 ADMIN 或 SUPER_ADMIN\nSUPER_ADMIN 不可删除自身\nService 层校验后返回 403
    @GetMapping("/users/balance")
    @PreAuthorize("isAuthenticated()")
    + getBalance(): ResponseEntity
    @PutMapping("/users/{id}/role")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + changeRole(@PathVariable id, @RequestBody req): ResponseEntity
    note right of UserController : changeRole 仅限 ADMIN/SUPER_ADMIN\n禁止 ADMIN 自我提权或修改其他 ADMIN 角色\nService 层校验目标用户非本人\n角色变更属敏感操作，必须记录 actor/action/target\n审计日志 payload 格式: {"old_role": "user", "new_role": "maintainer"}\n\ndeleteUser 安全约束：\n- ADMIN 不可删除/修改其他 ADMIN 或 SUPER_ADMIN\n- SUPER_ADMIN 不可删除自身\nService 层在 updateUser/deleteUser 中校验\n违反约束返回 HTTP 403\n\nresetPassword / changePassword 同样记录审计日志\n密码变更属敏感操作，记录 actor_id + clientIp
  }

  class RepairController {
    @PostMapping("/repairs")
    @PreAuthorize("isAuthenticated()")
    + submitRepair(@RequestBody req): ResponseEntity
    @GetMapping("/repairs")
    @PreAuthorize("isAuthenticated()")
    + listRepairs(@RequestParam params): ResponseEntity
    note right of RepairController : listRepairs 在 Service 层按角色过滤\n普通用户仅能看到自己的报修
    @PutMapping("/repairs/{id}/assign")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + assignRepair(@PathVariable id, @RequestBody req): ResponseEntity
    @PutMapping("/repairs/{id}/claim")
    @PreAuthorize("hasAnyRole('MAINTAINER', 'ADMIN')")
    + claimRepair(@PathVariable id): ResponseEntity
    @PutMapping("/repairs/{id}/resolve")
    @PreAuthorize("hasRole('MAINTAINER') or hasRole('ADMIN')")
    + resolveRepair(@PathVariable id): ResponseEntity
    @PutMapping("/repairs/{id}/close")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + closeRepair(@PathVariable id): ResponseEntity
    @PutMapping("/repairs/{id}/reject")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + rejectRepair(@PathVariable id, @RequestBody req): ResponseEntity
  }

  class StationController {
    @GetMapping("/stations")
    @PreAuthorize("isAuthenticated()")
    + listStations(): ResponseEntity
    @GetMapping("/stations/search")
    @PreAuthorize("isAuthenticated()")
    + searchStations(@RequestParam name): ResponseEntity
    @GetMapping("/stations/{id}")
    @PreAuthorize("isAuthenticated()")
    + getStation(@PathVariable id): ResponseEntity
    @PostMapping("/stations")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + createStation(@RequestBody req): ResponseEntity
    @PutMapping("/stations/{id}")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + updateStation(@PathVariable id, @RequestBody req): ResponseEntity
    @DeleteMapping("/stations/{id}")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + deleteStation(@PathVariable id): ResponseEntity
    @GetMapping("/chargers")
    @PreAuthorize("isAuthenticated()")
    + listChargers(@RequestParam params): ResponseEntity
    @GetMapping("/chargers/{id}")
    @PreAuthorize("isAuthenticated()")
    + getCharger(@PathVariable id): ResponseEntity
    @GetMapping("/chargers/by-code/{code}")
    @PreAuthorize("isAuthenticated()")
    + getChargerByCode(@PathVariable code): ResponseEntity
    @PostMapping("/chargers")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + createCharger(@RequestBody req): ResponseEntity
    @PutMapping("/chargers/{id}")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN', 'MAINTAINER')")
    + updateCharger(@PathVariable id, @RequestBody req): ResponseEntity
    @DeleteMapping("/chargers/{id}")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + deleteCharger(@PathVariable id): ResponseEntity
  }

  class StatisticsController {
    @GetMapping("/analytics/charges")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + generateReport(): ResponseEntity
    @GetMapping("/analytics/user-charges")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + getUserChargingStats(): ResponseEntity
    @GetMapping("/analytics/revenue")
    @PreAuthorize("hasRole('SUPER_ADMIN')")
    + getRevenueStats(): ResponseEntity
    @GetMapping("/analytics/utilization")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + getChargerUtilization(): ResponseEntity
    @GetMapping("/analytics/fault-chargers")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + getFaultChargers(): ResponseEntity
    @GetMapping("/analytics/stations")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + getStationAnalysis(): ResponseEntity
    @GetMapping("/analytics/export")
    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    + exportCsv(): ResponseEntity
  }
}

package "服务 (Service)" as SVC #F0E68C {
  interface ChargingService {
    + startCharge()
    + stopCharge()
    + calculateFee()
    + forceStop()
    + queryCharges(params: Map): List
  }

  class ChargingServiceImpl implements ChargingService {
    + startCharge()
    + stopCharge()
    + calculateFee()
    + forceStop()
    + queryCharges(params: Map): List
  }
  note right of ChargingServiceImpl : @Transactional(propagation = Propagation.REQUIRED) 事务控制\n同类内方法调用时 @Transactional 不生效\n必须通过代理对象调用或拆分事务边界\n@PreAuthorize 授权检查\n\n充电流程：\n1. 校验余额 >= 10 元\n2. ChargerConnector 通知充电桩\n3. 桩 ACK 后标记 CHARGING\n4. 结束: 余额不足/用户主动/桩异常

  interface PaymentService {
    + recharge()
    + processCallback()
    + autoDeduct()
  }

  class PaymentServiceImpl implements PaymentService {
    + recharge()
    + processCallback()
    + autoDeduct()
  }

  interface RepairService {
    + submit()
    + listRepairs(params: Map): List
    + assign()
    + resolve()
    + close()
    + reject()
  }

  class RepairServiceImpl implements RepairService {
    + submit()
    + listRepairs(params: Map): List
    + assign()
    + resolve()
    + close()
    + reject()
  }

  interface UserService {
    + login()
    + register()
    + refreshToken()
    + resetPassword()
    + confirmPasswordReset()
    + changePassword()
    + listUsers()
    + updateUser()
    + deleteUser()
    + getBalance()
    + changeRole()
  }

  class UserServiceImpl implements UserService {
    + login()
    + register()
    + refreshToken()
    + resetPassword()
    + confirmPasswordReset()
    + changePassword()
    + listUsers()
    + updateUser()
    + deleteUser()
    + getBalance()
    + changeRole()
  }

  interface ChargerService {
    + restoreCharger(chargerId: UUID): void
    + getChargerStatus(chargerId: UUID): ChargerStatus
    + updateStatus(chargerId: UUID, status: ChargerStatus): void
  }

  class ChargerServiceImpl implements ChargerService {
    + restoreCharger(chargerId: UUID): void
    + getChargerStatus(chargerId: UUID): ChargerStatus
    + updateStatus(chargerId: UUID, status: ChargerStatus): void
  }
  note right of ChargerServiceImpl : 充电桩管理服务\n供 RepairService 在报修关闭时\n将充电桩从 fault 恢复为 idle\nupdateStatus() 供报修提交时\n将充电桩状态设为 fault

  interface StatisticsService {
    + generateReport(): ReportVO
    + getUserChargingStats(): List
    + getStationAnalysis(): List
    + getChargerUtilization(): Map
    + getRevenueStats(): ReportVO
    + getFaultChargers(): List
    + exportCsv(type: String, params: Map): byte[]
  }

  class StatisticsServiceImpl implements StatisticsService {
    + generateReport(): ReportVO
    + getUserChargingStats(): List
    + getStationAnalysis(): List
    + getChargerUtilization(): Map
    + getRevenueStats(): ReportVO
    + getFaultChargers(): List
    + exportCsv(type: String, params: Map): byte[]
  }

  interface BillingService {
    + calculateFee(chargerType, energyKwh): BigDecimal
  }

  class BillingServiceImpl implements BillingService {
    + calculateFee(chargerType, energyKwh): BigDecimal
  }
}

package "策略/工厂 (Design Pattern)" as DP #E6E6FA {
  interface PricingStrategy {
    + calculatePrice(type: ChargerType, energyKwh: BigDecimal): BigDecimal
  }

  class StandardPricing implements PricingStrategy {
    + calculatePrice(type: ChargerType, energyKwh: BigDecimal): BigDecimal
  }
  note right of StandardPricing : 标准定价: FAST 1.5 元/kWh\nSLOW 0.8 元/kWh\n简单策略，无时段区分

  class PeakPricing implements PricingStrategy {
    + calculatePrice(type: ChargerType, energyKwh: BigDecimal): BigDecimal
  }
  note right of PeakPricing : 峰时定价: 高峰期(8:00-22:00)上浮 50%\n低谷期(22:00-8:00)下浮 30%\n时段计费扩展策略

  class PaymentFactory {
    + {static} createChannel(method: String): PaymentChannel
  }
  note right of PaymentFactory : 根据 method 参数返回对应通道\n"wechat" -> WeChatPayChannel\n"alipay" -> AliPayChannel\n"system" -> SystemAutoDeductChannel\n默认 -> WeChatPayChannel

  interface PaymentChannel {
    + processPayment(amount: BigDecimal): boolean
    + verifySignature(payload: JSON): boolean
  }
  note right of PaymentChannel : 支付通道接口\n微信/支付宝/信用卡\n各通道独立实现

  class WeChatPayChannel implements PaymentChannel {
    + processPayment(amount: BigDecimal): boolean
    + verifySignature(payload: JSON): boolean
  }
  note right of WeChatPayChannel : 微信支付通道\n调用微信支付 SDK\nHMAC-SHA256 签名校验

  class AliPayChannel implements PaymentChannel {
    + processPayment(amount: BigDecimal): boolean
    + verifySignature(payload: JSON): boolean
  }
  note right of AliPayChannel : 支付宝支付通道\n调用支付宝 SDK\nRSA2 签名校验
}

package "数据访问层 (Mapper/MyBatis)" as MAP #90EE90 {
  interface UserMapper {
    @Select("SELECT * FROM users WHERE phone = #{phone}")
    + findByPhone(phone: String): User
    @Insert("INSERT INTO users ...")
    + insert(user: User): int
    @Update("UPDATE users SET balance = balance - #{amount} WHERE id = #{userId} AND balance >= #{amount}")
    + deductBalance(userId: UUID, amount: BigDecimal): int
    @Update("UPDATE users SET failed_login_attempts = failed_login_attempts + 1 WHERE phone = #{phone}")
    + incrementFailedAttempts(phone: String): int
    @Update("UPDATE users SET failed_login_attempts = 0, account_locked_until = NULL WHERE phone = #{phone}")
    + resetFailedAttempts(phone: String): int
  }

  interface ChargerMapper {
    @Select("SELECT * FROM chargers WHERE id = #{id}")
    + findById(id: UUID): Charger
    @Select("SELECT * FROM chargers WHERE station_id = #{stationId}")
    + findByStationId(stationId: UUID): List
    @Update("UPDATE chargers SET status = #{status} WHERE id = #{id} AND status = #{expectedStatus}")
    + updateStatus(id: UUID, status: String, expectedStatus: String): int
    @Select("SELECT * FROM chargers")
    + findAll(): List
  }

  interface ChargeRecordMapper {
    @Insert("INSERT INTO charge_records ...")
    + insert(record: ChargeRecord): int
    @Update("UPDATE charge_records SET end_time = now(), energy_kwh = #{energy}, fee = #{fee}, status = 'completed', deduction_status = #{deductionStatus} WHERE id = #{id}")
    + completeRecord(id: UUID, energy: BigDecimal, fee: BigDecimal, deductionStatus: String): int
    @Select("SELECT cr.*, c.status as charger_status, u.balance FROM charge_records cr JOIN chargers c ON cr.charger_id = c.id JOIN users u ON cr.user_id = u.id WHERE cr.id = #{id} FOR UPDATE")
    + findByIdWithLock(id: UUID): Map
    @Select("<script>SELECT * FROM charge_records WHERE user_id = #{userId} <if test='status != null'>AND status = #{status}</if> ORDER BY start_time DESC</script>")
    + findByUserId(userId: UUID, status: String, pageable: Pageable): List
  }

  interface PaymentMapper {
    @Insert("INSERT INTO payments ...")
    + insert(payment: Payment): int
    @Select("SELECT * FROM payments WHERE gateway_tx_id = #{txId}")
    + findByGatewayTxId(txId: String): Payment
    @Select("SELECT * FROM payments WHERE user_id = #{userId} ORDER BY created_at DESC")
    + findByUserId(userId: UUID, pageable: Pageable): List
  }

  interface RepairMapper {
    @Insert("INSERT INTO repairs ...")
    + insert(repair: Repair): int
    @Select("SELECT * FROM repairs WHERE id = #{id} FOR UPDATE")
    + findByIdWithLock(id: UUID): Repair
    @Update("UPDATE repairs SET status = #{status}, handled_by = #{userId}, handled_at = now() WHERE id = #{id}")
    + updateStatus(id: UUID, status: String, userId: UUID): int
  }

  interface AuditLogMapper {
    @Insert("INSERT INTO audit_logs ...")
    + insert(log: AuditLog): int
  }
}

package "基础设施 (Infrastructure)" as INF #DDA0DD {
  class HikariDataSource {
    + getConnection(): Connection
    + setMaximumPoolSize(size: int)
    + setMinimumIdle(idle: int)
    + setConnectionTimeout(timeout: long)
  }
  note right of HikariDataSource : HikariCP 连接池\nSpring Boot 默认\nmax-active: 20\nmin-idle: 5

  class AdvancedApiKeyFilter {
    + doFilterInternal(request, response, filterChain)
  }
  note right of AdvancedApiKeyFilter : 高级权限密钥过滤器\n@Order(0) 在 JWT Filter 之前执行\n校验 X-Advanced-Api-Key header\n匹配配置密钥后授予 SUPER_ADMIN 权限\nscope=advanced，用于测试环境

  class SqlSessionFactoryBean {
    + setDataSource(dataSource: DataSource)
    + setMapperLocations(locations: Resource[])
    + setTypeAliasesPackage(pkg: String)
    + getObject(): SqlSessionFactory
  }
  note right of SqlSessionFactoryBean : MyBatis 核心工厂\n扫描 mapper/*.xml\n注册类型别名

  class PlatformTransactionManager {
    + getTransaction(def: TransactionDefinition): TransactionStatus
    + commit(status: TransactionStatus)
    + rollback(status: TransactionStatus)
  }

  class DataSourceTransactionManager {
    + doBegin(transaction: Object, definition: TransactionDefinition)
    + doCommit(status: DefaultTransactionStatus)
    + doRollback(status: DefaultTransactionStatus)
  }

  interface ChargerConnector {
    + notifyStart(chargerCode: String, recordId: UUID): boolean
    + notifyStop(chargerCode: String, recordId: UUID): boolean
    + isOnline(chargerCode: String): boolean
  }
  note right of ChargerConnector : 充电桩通讯中间件接口\nHTTP polling 实现（后续升级 WebSocket）\nSpring 通知充电桩启动/停止\n检测充电桩在线状态\n当前为 stub 实现

  class HttpChargerConnector implements ChargerConnector {
    + notifyStart(chargerCode: String, recordId: UUID): boolean
    + notifyStop(chargerCode: String, recordId: UUID): boolean
    + isOnline(chargerCode: String): boolean
  }
  note right of HttpChargerConnector : HTTP 方式通知充电桩\n通过 OkHttp 发送 POST 请求\n超时 5 秒\n连接失败 = 充电桩离线

  class RedisTemplate {
    + opsForValue(): ValueOperations
    + opsForSet(): SetOperations
    + expire(key: String, timeout: long, unit: TimeUnit): boolean
    + delete(key: String): boolean
  }
  note right of RedisTemplate : 缓存 Token/验证码/封禁状态\nrefresh_token 存储\njti 黑名单\n登录失败计数

  class PageHelper {
    + startPage(pageNum: int, pageSize: int)
    + getTotal(): long
    + getPages(): int
  }
  note right of PageHelper : MyBatis 分页插件\n自动拼接 LIMIT/OFFSET\nThreadLocal 安全
}

