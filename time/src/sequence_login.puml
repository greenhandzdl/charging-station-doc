@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 14
title 用户登录时序图

' 所有 SQL 操作使用 PreparedStatement 参数绑定，禁止字符串拼接
actor 用户 as U
participant "Flutter 客户端" as FE
participant "认证控制器" as Ctrl
participant "用户服务" as US
participant "Redis" as Cache
database 数据库 as DB

U -> FE: 输入手机号与密码，点击登录
FE -> Ctrl: HTTP POST /api/v1/auth/login\n{phone, password}
note right FE : ApiService.login() 发送 JSON 请求\nContent-Type: application/json

group 暴力破解防护 [Rate Limiting & Account Lockout]
  Ctrl -> Cache: INCR login:fail:ip:{clientIp}\nTTL 300 (5分钟)
  Cache --> Ctrl: 登录失败次数(IP维度)

  alt IP 维度失败次数 >= 10
    Ctrl --> FE: HTTP 429 {error: "IP 被封禁 30 分钟"}
    FE --> U: 显示"登录过于频繁，请30分钟后再试"
    note right Ctrl : 结束流程，不继续执行
  else IP 维度失败次数 >= 5
    Ctrl --> FE: HTTP 400 {error: "需要验证码"}
    FE --> U: 显示验证码输入框
    U -> FE: 输入验证码
    FE -> Ctrl: HTTP POST /api/v1/auth/login\n{phone, password, captchaId, captchaCode}
    Ctrl -> Cache: GET captcha:{captchaId}
    Cache --> Ctrl: 验证码值
    alt 验证码错误
      Ctrl --> FE: HTTP 400 {error: "验证码错误"}
      FE --> U: 提示验证码错误，刷新验证码
      note right Ctrl : 结束流程，不继续执行
    end
  end
end

Ctrl -> US: login(phone, password)
US -> DB: SELECT id, name, password_hash, role,\nfailed_login_attempts, account_locked_until\nFROM users WHERE phone = ?
DB --> US: 用户记录（或空结果）

alt 用户不存在
  US --> Ctrl: 认证失败
  Ctrl --> Cache: INCR login:fail:ip:{clientIp}
  Ctrl --> FE: HTTP 401 {error: "手机号或密码错误"}
  FE --> U: 显示错误提示
else 用户存在
  alt 账户已锁定
    US --> Ctrl: 账户已锁定
    Ctrl --> FE: HTTP 423 {error: "账户已被锁定，请稍后再试"}
    FE --> U: 显示"账户已被锁定"
  else 账户未锁定
    US -> US: bcrypt 校验密码散列

    alt 密码正确
      US -> DB: UPDATE users SET failed_login_attempts = 0, account_locked_until = NULL WHERE id = ?
      DB --> US: 重置成功
      US -> US: 生成 access_token (15min) + refresh_token (7d)
      US -> Cache: SET refresh_token:{userId} = token EX 604800
      Cache --> US: 存储成功
      US --> Ctrl: LoginResponse {accessToken, refreshToken, userInfo}
      Ctrl --> FE: HTTP 200 JSON {access_token, refresh_token, user}
      FE -> FE: AuthProvider 保存 Token 到内存
      FE --> U: 跳转主界面
    else 密码错误
      US -> DB: UPDATE users SET failed_login_attempts = failed_login_attempts + 1 WHERE id = ?
      DB --> US: 失败计数增加
      alt failed_login_attempts >= 10
        US -> DB: UPDATE users SET account_locked_until = now() + INTERVAL '30 minutes' WHERE id = ?
        DB --> US: 账户已锁定
        US --> Ctrl: 账户已锁定
        Ctrl --> FE: HTTP 423 {error: "登录失败次数过多，账户已被锁定 30 分钟"}
        FE --> U: 提示
      else
        US --> Ctrl: 认证失败
        Ctrl --> Cache: INCR login:fail:ip:{clientIp}
        Ctrl --> FE: HTTP 401 {error: "手机号或密码错误"}
        FE --> U: 显示错误提示
      end
    end
  end
end
@enduml