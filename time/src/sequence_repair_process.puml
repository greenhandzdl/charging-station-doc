@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 14
title 报修处理时序图

' 所有 SQL 操作使用 PreparedStatement 参数绑定，禁止字符串拼接
actor 管理员 as Admin
actor 维修人员 as M
participant "Flutter 客户端" as FE
participant "报修控制器" as Ctrl
participant "安全过滤器链" as Security
participant "报修服务" as RS
participant "充电桩服务" as CS
database 数据库 as DB

== 管理员查看未处理报修单 ==
Admin -> FE: 进入报修管理页面
FE -> Ctrl: HTTP GET /api/v1/repairs?status=open

group 授权检查 [Spring Security Filter Chain]
  Ctrl -> Security: JwtAuthenticationFilter 解析 Token\n提取 principal (userId, role, mockScope)

  alt Token scope = mock_charger_only
    Security --> Ctrl: HTTP 403 Forbidden {error: "Mock 客户端无权访问报修管理"}
    Ctrl --> FE: HTTP 403 {error: "权限不足"}
    FE --> Admin: 提示"无权访问"
    note right Security : Mock 客户端 scope=mock_charger_only\n禁止访问 /api/v1/repairs/* 端点
  else 正常用户 Token
    Security -> Security: @PreAuthorize("isAuthenticated()")
    note right Security : 验证通过后将请求传递给 Controller
    note right Security : Service 层按角色过滤报修记录\n普通用户仅能看到自己的报修\n管理员可查看全部
  end
end

Ctrl -> RS: listRepairs(params)
note right RS #FFE4B5 : Service 层根据角色动态拼接查询条件：\n如果当前角色不是 ADMIN/SUPER_ADMIN/MAINTAINER\n追加 AND reporter_id = :currentUserId\n防止普通用户查看他人的报修记录

RS -> DB: SELECT r.*, c.charger_code, u.name as reporter_name\nFROM repairs r\nJOIN chargers c ON r.charger_id = c.id\nJOIN users u ON r.reporter_id = u.id\nWHERE r.status = 'open' ORDER BY r.reported_at DESC
DB --> RS: 未处理报修单列表
RS --> Ctrl: List<RepairDTO>
Ctrl --> FE: HTTP 200 JSON {repairs: [...]}
FE --> Admin: 展示待处理报修清单

alt 管理员直接关闭报修
  Admin -> FE: 选择报修单，点击"直接关闭"
  FE -> Ctrl: HTTP PUT /api/v1/repairs/{id}/close

  group 授权检查 [@PreAuthorize]
    Ctrl -> Security: @PreAuthorize("hasRole('ADMIN') or hasRole('SUPER_ADMIN')")
    note right Security : 直接关闭报修仅限管理员或最高管理者\n不通过则返回 403 Forbidden
  end

  group 事务 [atomic] 覆盖: 关闭报修单 + 审计日志
    Ctrl -> RS: close(repairId)
    RS -> DB: UPDATE repairs SET status = 'closed',\nhandled_at = now() WHERE id = ? AND status = 'open'
    note right DB : 直接关闭时充电桩状态不变\n（桩未实际故障）
    DB --> RS: 报修关闭

    RS -> DB: INSERT INTO audit_logs (actor_id, actor_type, action, resource, resource_id)\nVALUES (?, 'admin', 'close_repair_direct', 'repair', ?)
    DB --> RS: 审计日志记录成功
  end

  RS --> Ctrl: 报修直接关闭
  Ctrl --> FE: HTTP 200 {status: 'closed', message: "报修已直接关闭"}
  FE --> Admin: 显示"报修已直接关闭"

else 管理员分配维修人员
  Admin -> FE: 选择报修单，指定维修人员\n点击"分配"
  FE -> Ctrl: HTTP PUT /api/v1/repairs/{id}/assign\n{handledBy: maintainerId}

  group 授权检查 [@PreAuthorize]
    Ctrl -> Security: @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
    note right Security : 分配维修人员仅限管理员或最高管理者或最高管理者\n不通过则返回 403 Forbidden
  end

  Ctrl -> RS: assign(repairId, maintainerId)
  RS -> DB: UPDATE repairs SET status = 'in_progress',\nhandled_by = ? WHERE id = ? AND status = 'open'
  DB --> RS: 分配成功
  RS --> Ctrl: 分配完成
  Ctrl --> FE: HTTP 200 {status: 'in_progress'}
  FE --> Admin: 显示"已分配待维修"

  == 维修人员进行维修 ==
  note right of FE : 维修人员刷新或收到通知查看任务

  M -> FE: 查看被分配的报修单
  FE -> Ctrl: HTTP GET /api/v1/repairs?handledBy={myId}
  Ctrl --> FE: 返回待维修列表

  M -> FE: 维修完成，点击"维修完成"
  FE -> Ctrl: HTTP PUT /api/v1/repairs/{id}/resolve

  group 授权检查 [@PreAuthorize]
    Ctrl -> Security: @PreAuthorize("hasRole('MAINTAINER') or hasRole('ADMIN')")
    note right Security : 标记维修完成仅限维修人员或管理员\n不通过则返回 403 Forbidden
  end

  Ctrl -> RS: resolve(repairId)
  RS -> RS: 校验: 当前 MAINTAINER 为 assigned handler\n(handledBy == currentUserId)
  note right #F0E68C : MAINTAINER 只能处理自己被分配的报修\n非 assigned handler 返回 403 Forbidden\n管理员(ADMIN)可标记任意报修
  RS -> DB: UPDATE repairs SET status = 'resolved'\nWHERE id = ? AND status = 'in_progress'
  DB --> RS: 维修完成标记
  RS --> Ctrl: 已标记待审核
  Ctrl --> FE: HTTP 200 {status: 'resolved'}
  FE --> M: 显示"维修完成，待管理员审核"

  == 管理员审核 ==
  Admin -> FE: 查看已完成的维修记录

  alt 审核通过
    Admin -> FE: 点击"审核通过"
    FE -> Ctrl: HTTP PUT /api/v1/repairs/{id}/close

    group 授权检查 [@PreAuthorize]
      Ctrl -> Security: @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
      note right Security : 审核关闭报修仅限管理员或最高管理者\n不通过则返回 403 Forbidden
    end

    group 事务 [atomic] 覆盖: 关闭报修单 + 恢复充电桩 + 审计日志
      Ctrl -> RS: close(repairId)
      RS -> DB: UPDATE repairs SET status = 'closed',\nhandled_at = now() WHERE id = ?
      DB --> RS: 报修关闭

      RS -> CS: restoreCharger(chargerId)
      CS -> DB: UPDATE chargers SET status = 'idle'\nWHERE id = ? AND status = 'fault' -- 使用 PreparedStatement 参数绑定
      DB --> CS: 桩已恢复

      RS -> DB: INSERT INTO audit_logs (actor_id, actor_type, action, resource, resource_id)\nVALUES (?, 'admin', 'close_repair', 'repair', ?)
      DB --> RS: 审计日志记录成功
    end

    RS --> Ctrl: 报修处理完成
    Ctrl --> FE: HTTP 200 {status: 'closed', message: "报修处理完成"}
    FE --> Admin: 显示"处理完成，充电桩已恢复"

  else 审核不通过
    Admin -> FE: 点击"审核不通过"\n填写退回原因
    FE -> Ctrl: HTTP PUT /api/v1/repairs/{id}/reject\n{reason: "维修不彻底，需重新处理"}

    group 授权检查 [@PreAuthorize]
      Ctrl -> Security: @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN')")
      note right Security : 审核退回仅限管理员或最高管理者\n不通过则返回 403 Forbidden
    end

    Ctrl -> RS: reject(repairId, reason)
    RS -> DB: UPDATE repairs SET status = 'in_progress',\nreject_reason = ? WHERE id = ? AND status = 'resolved'
    note right DB : 状态从 resolved 回退到 in_progress，维修人员重新处理
    DB --> RS: 退回成功

    RS -> DB: INSERT INTO audit_logs (actor_id, actor_type, action, resource,\nresource_id, payload)\nVALUES (?, 'admin', 'reject_repair', 'repair', ?, ?::jsonb)
    DB --> RS: 审计日志记录成功

    RS --> Ctrl: 退回成功
    Ctrl --> FE: HTTP 200 {status: 'in_progress', message: "已退回，维修人员重新处理"}
    FE --> Admin: 显示"已退回，维修人员将重新处理"

    note right of M : 维修人员收到退回通知后重新维修
    M -> FE: 查看退回的报修单\n及退回原因
    M -> FE: 重新维修完成后再次提交审核
    FE -> Ctrl: HTTP PUT /api/v1/repairs/{id}/resolve
    note right FE : 重复 resolve → 审核流程
  end
end
@enduml